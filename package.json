{
  "name": "@streamestate/sdk",
  "version": "0.1.0-beta.0",
  "description": "Official TypeScript SDK for the Stream Estate API V2 (beta) — French real-estate listings, transactions, alerts and geography.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "create-stream-estate": "bin/create-stream-estate.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "openapi-typescript https://next.docs.stream.estate/openapi.json -o src/generated/schema.ts",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "keywords": [
    "stream-estate",
    "real-estate",
    "real estate api",
    "property data",
    "listings",
    "france",
    "proptech"
  ],
  "license": "MIT",
  "homepage": "https://next.docs.stream.estate",
  "bugs": {
    "url": "https://github.com/StreamEstate/sdk-js/issues",
    "email": "support@stream.estate"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StreamEstate/sdk-js.git"
  }
}
